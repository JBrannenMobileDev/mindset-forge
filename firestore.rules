rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write ONLY their own profile.
    // Accountability partners do NOT get direct read access to the primary's
    // doc (it holds private data: beliefs, fears, coach memory, etc). Partners
    // read a privacy-curated subset via the getPartnerProgress callable instead.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Journal entries belong to their owner (field name is uid, not userId)
    match /journals/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Chat sessions belong to their owner (field name is uid, not userId)
    match /chat_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Partner invites — fully locked to clients. All reads/writes happen
    // through Cloud Functions (getPartnerInviteInfo / acceptPartnerInvite)
    // using the Admin SDK, which bypasses these rules. The client never
    // touches this collection directly, so deny all direct access.
    match /partner_invites/{inviteId} {
      allow read, write: if false;
    }

    // Viral metrics — written only by Cloud Functions (Admin SDK).
    match /viral_metrics/{docId} {
      allow read, write: if false;
    }

    // App config is read-restricted per document, and every doc is written only
    // via the Firebase console / admin scripts. Each doc gets an explicit match
    // block so that any config doc added later is denied by default instead of
    // inheriting a public read.

    // Analyst allowlist + coach signup codes. Never client-readable: a leaked
    // signup code would let anyone mint a free coach account on the public
    // signup page, and the analyst allowlist should not be enumerable. Cloud
    // Functions use the Admin SDK and the rule helpers below use get(), both of
    // which bypass this rule, so denying reads costs us nothing.
    match /app_config/roles {
      allow read, write: if false;
    }

    // Blog CMS admin allowlist — read by the signed-in admin portal only.
    match /app_config/blog {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App version gate config — read by every client (including signed-out
    // and pre-update users) at startup to detect forced/feature update
    // requirements, so this one stays publicly readable.
    match /app_config/version {
      allow read: if true;
      allow write: if false;
    }

    // Onboarding attribution options ("How did you hear about us?"). Read by
    // signed-in users during onboarding. Write stays server-only so the
    // partner list cannot be tampered with from a client. Nothing sensitive
    // lives here: it is a list of channel and partner display labels.
    match /app_config/attribution_sources {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Every other config doc (mindset_progress, callback, …) is read
    // server-side with the Admin SDK, so clients get nothing.
    match /app_config/{docId} {
      allow read, write: if false;
    }

    function isBlogAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/app_config/blog) &&
        request.auth.uid in get(/databases/$(database)/documents/app_config/blog).data.adminUids;
    }

    // Blog CMS — admin-only. Public site reads posts at build time via Admin SDK.
    match /blog_posts/{slug} {
      allow read, write: if isBlogAdmin();
      allow create: if isBlogAdmin();
    }

    // Blog topic seed inbox — admin-only queue for draft generation.
    match /blog_seeds/{seedId} {
      allow read, write, create: if isBlogAdmin();
    }

    // ---------------------------------------------------------------------
    // Coach team portal
    //
    // Every write below is `if false`. All team mutations go through the coach
    // callables (initializeCoachAccount, createPlayerInvites, acceptTeamInvite,
    // assignTeamPrompt, …) and the journal-summary trigger, which use the Admin
    // SDK and bypass these rules entirely. Reads are split so that a player can
    // see their team and the daily prompt but nothing about their teammates,
    // and a coach can never reach raw journal text: `journals` stays owner-only
    // and `team_entry_summaries` has no content field by contract.
    // ---------------------------------------------------------------------

    // Super-admin analyst: full read access to every team.
    function isAnalyst() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/app_config/roles) &&
        request.auth.uid in get(/databases/$(database)/documents/app_config/roles).data.analystUids;
    }

    function isTeamCoach(teamId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.coachUid == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids;
    }

    // Team doc: staff only.
    //
    // Players deliberately have NO read access here. The original plan gave
    // members read access so the app could read `promptMode`, but that field is
    // gone (the app never forces a player onto the coach's prompt), and the app
    // now reads nothing but the schedule doc below. Leaving member reads in
    // place would expose `memberUids` (every teammate's uid) and
    // `guidance.notes` (free text the coach writes for the prompt generator,
    // which can easily be about a specific player) to the whole roster.
    // `isTeamMember` is still used by the schedule rule; rule get() calls
    // bypass these read rules, so denying the doc costs the app nothing.
    match /teams/{teamId} {
      allow read: if isTeamCoach(teamId) || isAnalyst();
      allow write: if false;
    }

    // Prompt bank — staff only. Players only ever see the assigned prompt.
    match /teams/{teamId}/prompts/{promptId} {
      allow read: if isTeamCoach(teamId) || isAnalyst();
      allow write: if false;
    }

    // Daily schedule — players read this; it is the assigned journal prompt.
    match /teams/{teamId}/schedule/{date} {
      allow read: if isTeamCoach(teamId) || isAnalyst() || isTeamMember(teamId);
      allow write: if false;
    }

    // Roster holds other players' names, emails and invite ids — staff only.
    match /teams/{teamId}/roster/{playerId} {
      allow read: if isTeamCoach(teamId) || isAnalyst();
      allow write: if false;
    }

    // AI weekly roll-ups — staff only.
    match /teams/{teamId}/reports/{period} {
      allow read: if isTeamCoach(teamId) || isAnalyst();
      allow write: if false;
    }

    // AI summaries of player entries. Never contains raw journal text. Scoped
    // by the summary's own teamId so a coach can only ever see their own team.
    // Does NOT carry concernLevel (that lives in team_entry_signals).
    match /team_entry_summaries/{entryId} {
      allow read: if isTeamCoach(resource.data.teamId) || isAnalyst();
      allow write: if false;
    }

    // Concern signals (watch/flag). Analyst only. Coaches must not be able to
    // read these even via DevTools; that is why they are not on the summary doc.
    match /team_entry_signals/{entryId} {
      allow read: if isAnalyst();
      allow write: if false;
    }

    // Team invites — fully locked to clients, mirroring partner_invites. The
    // join page reads them through getTeamInviteInfo / acceptTeamInvite.
    match /team_invites/{inviteId} {
      allow read, write: if false;
    }
  }
}
